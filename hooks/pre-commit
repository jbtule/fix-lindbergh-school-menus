#!/bin/sh
# Cache-busts app.js/style.css/station-boundaries.js/version.js in index.html
# (config.js and menu-api.js aren't tagged there - app.js imports them
# directly as ES modules, so those two get busted on their import
# specifiers inside app.js instead - see bust_in() below) so GitHub Pages'
# CDN doesn't serve stale assets after a deploy. Also writes a combined
# version marker to version.js (loaded before app.js) so a running page can
# detect when a newer version has been deployed - see checkForUpdate() in
# app.js. version.js is its own file rather than a constant embedded in
# app.js so that computing app.js's own hash never has to account for a
# value app.js also produces - no self-reference, no risk of drifting on
# every run.
#
# This hook lives in the repo (not .git/hooks, which isn't versioned) -
# activate it once per clone with:
#   git config core.hooksPath hooks

set -e
cd "$(git rev-parse --show-toplevel)"

hash_of() { shasum -a 256 "$1" | cut -c1-8; }

# The existing ?v= value is matched as [^"]* rather than [a-f0-9]+ so that a
# hand-set placeholder (e.g. ?v=dev1, used while testing locally) is rewritten
# too - the old hex-only pattern silently left those in place, which would
# have shipped an un-bustable asset URL.
bust() {
  file="$1"
  hash="$2"
  sed -E -i.bak "s#(\"$file)(\?v=[^\"]*)?\"#\1?v=$hash\"#" index.html
  rm -f index.html.bak
}

# Same idea as bust(), but for an ES module's own import specifier (e.g.
# `from "./config.js?v=..."` inside app.js) rather than a <script> tag in
# index.html - config.js/menu-api.js aren't script-tagged there themselves
# (app.js imports them directly), so their cache-busting query string has to
# live on that import line instead.
bust_in() {
  target="$1"
  module="$2"
  hash="$3"
  sed -E -i.bak "s#(\"\./$module)(\?v=[^\"]*)?\"#\1?v=$hash\"#" "$target"
  rm -f "$target.bak"
}

# station-boundaries.js is optional by design - its own header documents
# deleting it as a supported way to turn the feature off - so every reference
# to it here tolerates the file being absent rather than failing the commit.
OPTIONAL_FILES="station-boundaries.js"

# Rewrite app.js's own import specifiers *before* hashing app.js below - its
# hash (and the version marker) must reflect the final file content,
# including whatever ?v= config.js/menu-api.js end up with.
bust_in app.js config.js "$(hash_of config.js)"
bust_in app.js menu-api.js "$(hash_of menu-api.js)"

bust app.js "$(hash_of app.js)"
bust style.css "$(hash_of style.css)"
for f in $OPTIONAL_FILES; do
  [ -f "$f" ] && bust "$f" "$(hash_of "$f")"
done

# Anything cache-busted above also belongs in the version marker, or a deploy
# that only changed that file would not prompt a running page to reload.
version_inputs="app.js config.js style.css menu-api.js"
for f in $OPTIONAL_FILES; do
  [ -f "$f" ] && version_inputs="$version_inputs $f"
done
version=$(cat $version_inputs | shasum -a 256 | cut -c1-8)
cat > version.js <<EOF
// Auto-generated by hooks/pre-commit on every commit - do not hand-edit.
// See checkForUpdate() in app.js.
const APP_VERSION = "$version";
EOF
bust version.js "$version"

git add index.html version.js app.js
